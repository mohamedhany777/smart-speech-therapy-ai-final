# Only needed when deploying the frontend separately from the backend
# (e.g. frontend on Render Static Site, backend on a Render Web Service).
# Leave unset for local dev (Vite proxy) and for the Docker Compose setup
# (nginx.conf already proxies /api/ to the backend container).
#
# Example: VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1
VITE_API_BASE_URL=
