# ==========================================================
# SMART SPEECH THERAPY AI - Backend Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==========================================================

# --- App ---
APP_NAME="Smart Speech Therapy AI"
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database ---
# For local dev without Postgres running, sqlite works out of the box:
# DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg2://sst_user:sst_password@localhost:5432/smart_speech_therapy

# --- Redis (sessions / rate limiting / caching / queues) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Storage backend (object/file storage) ---
STORAGE_BACKEND=local        # local | s3
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=smart-speech-therapy

# --- Vector database (Knowledge Base / RAG) ---
# "embedded" runs Qdrant in-process against local disk — no separate
# server needed, but single-process only (fine for dev / small deployments).
# For production with multiple backend workers, run a standalone Qdrant
# server (e.g. `docker run -p 6333:6333 qdrant/qdrant`) and set:
#   QDRANT_MODE=server
#   QDRANT_URL=http://qdrant:6333
QDRANT_MODE=embedded
QDRANT_PATH=./qdrant_storage
QDRANT_URL=

# --- LLM / real embeddings (OPTIONAL) ---
# Leave OPENAI_API_KEY empty to run with the built-in TF-IDF embeddings and
# extractive (no-generation) RAG responses — the app works fully without
# this. Setting a real key upgrades retrieval quality (dense embeddings)
# and enables real LLM-generated, source-grounded answers in the AI
# Assistant. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Web retrieval (OPTIONAL — Layer 2 knowledge fallback, spec section 15) ---
# Leave empty to run without web retrieval — the AI Assistant will say
# "no source found" instead of a web answer when the Knowledge Base has
# nothing relevant. Get a key at https://tavily.com (free tier available).
TAVILY_API_KEY=

# --- Speech-to-text backend ---
# "pocketsphinx" (default): fully offline, no download needed, always
# works — but English only and noticeably less accurate than modern ASR.
# "whisper": real neural ASR (OpenAI Whisper via Hugging Face
# Transformers) — genuinely multilingual, including Arabic, much higher
# accuracy. Requires:
#   1. pip install -r requirements-whisper.txt  (and a torch install —
#      see that file for CPU vs GPU instructions)
#   2. Real internet access on first use (downloads the model, then caches
#      it locally for offline reuse after that)
ASR_BACKEND=auto
WHISPER_MODEL_SIZE=openai/whisper-base

# --- Hugging Face Inference API (OPTIONAL but recommended) ---
# Real trained models, called remotely (near-zero local RAM/CPU cost —
# important on a resource-constrained instance like Render's free tier).
# Get a token at https://huggingface.co/settings/tokens (read access is
# enough). Once set, this automatically upgrades:
#   - Speech-to-text -> real multilingual Whisper (openai/whisper-large-v3-turbo),
#     including Arabic (see ASR_BACKEND=auto above)
#   - Stuttering-pattern detection -> a REAL trained classifier
#     (vocametrix/wav2vec2-xlsr-53-stuttering-classification, fine-tuned on
#     the published SEP-28k stuttering-event dataset) instead of DSP heuristics
#   - Knowledge Base embeddings -> real multilingual dense embeddings
#     (intfloat/multilingual-e5-base) instead of TF-IDF, if OPENAI_API_KEY
#     is not also set (OpenAI takes priority if both are configured)
HF_API_TOKEN=
HF_ASR_MODEL=openai/whisper-large-v3-turbo
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-base
HF_STUTTERING_MODEL=vocametrix/wav2vec2-xlsr-53-stuttering-classification
# Optional RAG reranking pass (off by default — adds one extra HTTP call
# per assistant query). Verified live on the HF Inference API as of this
# writing; see app/services/model_registry.py for the full verification
# note and docs/FINAL_PROJECT_REPORT.md for what "verified" does and
# doesn't mean here.
HF_RERANKER_MODEL=

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=20

# --- First admin bootstrap (used only by seed script) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-strong-password

# --- First specialist bootstrap (used only by seed script) ---
# Seeds a real, usable SPECIALIST account so the specialist-only
# therapy-plan/assessment approval flow is testable out of the box.
# Leave FIRST_SPECIALIST_EMAIL empty to skip seeding it.
FIRST_SPECIALIST_EMAIL=specialist@example.com
FIRST_SPECIALIST_PASSWORD=change-me-strong-password
